function Modelica.Blocks.Tables.Internal.getNextTimeEvent "Return next time event value of 1-dim. table where first column is time"
  input Modelica.Blocks.Types.ExternalCombiTimeTable tableID "External table object";
  input Real timeIn "(Scaled) time value";
  output Real nextTimeEvent "(Scaled) next time event in table";

  external "C" nextTimeEvent = ModelicaStandardTables_CombiTimeTable_nextTimeEvent(tableID, timeIn);
end Modelica.Blocks.Tables.Internal.getNextTimeEvent;

function Modelica.Blocks.Tables.Internal.getTimeTableTmax "Return maximum abscissa value of 1-dim. table where first column is time"
  input Modelica.Blocks.Types.ExternalCombiTimeTable tableID "External table object";
  output Real timeMax "Maximum abscissa value in table";

  external "C" timeMax = ModelicaStandardTables_CombiTimeTable_maximumTime(tableID);
end Modelica.Blocks.Tables.Internal.getTimeTableTmax;

function Modelica.Blocks.Tables.Internal.getTimeTableTmin "Return minimum abscissa value of 1-dim. table where first column is time"
  input Modelica.Blocks.Types.ExternalCombiTimeTable tableID "External table object";
  output Real timeMin "Minimum abscissa value in table";

  external "C" timeMin = ModelicaStandardTables_CombiTimeTable_minimumTime(tableID);
end Modelica.Blocks.Tables.Internal.getTimeTableTmin;

function Modelica.Blocks.Tables.Internal.getTimeTableValueNoDer "Interpolate 1-dim. table where first column is time (but do not provide a derivative function)"
  input Modelica.Blocks.Types.ExternalCombiTimeTable tableID "External table object";
  input Integer icol "Column number";
  input Real timeIn "(Scaled) time value";
  input Real nextTimeEvent "(Scaled) next time event in table";
  input Real pre_nextTimeEvent "Pre-value of (scaled) next time event in table";
  output Real y "Interpolated value";

  external "C" y = ModelicaStandardTables_CombiTimeTable_getValue(tableID, icol, timeIn, nextTimeEvent, pre_nextTimeEvent);
end Modelica.Blocks.Tables.Internal.getTimeTableValueNoDer;

impure function Modelica.Blocks.Types.ExternalCombiTimeTable.constructor "Initialize 1-dim. table where first column is time"
  input String tableName "Table name";
  input String fileName "File name";
  input Real[:, :] table;
  input Real startTime;
  input Integer[:] columns;
  input enumeration(LinearSegments, ContinuousDerivative, ConstantSegments, MonotoneContinuousDerivative1, MonotoneContinuousDerivative2, ModifiedContinuousDerivative) smoothness;
  input enumeration(HoldLastPoint, LastTwoPoints, Periodic, NoExtrapolation) extrapolation;
  input Real shiftTime = 0.0;
  input enumeration(Always, AtDiscontinuities, NoTimeEvents) timeEvents = Modelica.Blocks.Types.TimeEvents.Always;
  input Boolean verboseRead = true "= true: Print info message; = false: No info message";
  input String delimiter = "," "Column delimiter character for CSV file";
  input Integer nHeaderLines = 0 "Number of header lines to ignore for CSV file";
  output Modelica.Blocks.Types.ExternalCombiTimeTable externalCombiTimeTable;

  external "C" externalCombiTimeTable = ModelicaStandardTables_CombiTimeTable_init3(fileName, tableName, table, size(table, 1), size(table, 2), startTime, columns, size(columns, 1), smoothness, extrapolation, shiftTime, timeEvents, verboseRead, delimiter, nHeaderLines);
end Modelica.Blocks.Types.ExternalCombiTimeTable.constructor;

impure function Modelica.Blocks.Types.ExternalCombiTimeTable.destructor "Terminate 1-dim. table where first column is time"
  input Modelica.Blocks.Types.ExternalCombiTimeTable externalCombiTimeTable;

  external "C" ModelicaStandardTables_CombiTimeTable_close(externalCombiTimeTable);
end Modelica.Blocks.Types.ExternalCombiTimeTable.destructor;

class room_co2_ventilation.System "room_co2_ventilation: one instance per IR part and one connect per IR connection"
  parameter Real ctl_co2_201_bias(unit = "1/s") = 9.722222222222222e-4 "ctl_co2_201 bias [IR ctl_co2_201_bias]";
  parameter Real ctl_co2_201_gain(unit = "1/s") = 0.0016666666666666668 "ctl_co2_201 gain [IR ctl_co2_201_gain]";
  parameter Real ctl_co2_201_output_max(unit = "1/s") = 0.0016666666666666668 "ctl_co2_201 output_max [IR ctl_co2_201_output_max]";
  parameter Real ctl_co2_201_output_min(unit = "1/s") = 5.555555555555556e-5 "ctl_co2_201 output_min [IR ctl_co2_201_output_min]";
  parameter Real gain_air_201_gain(unit = "kg") = -119.99999987999999 "gain_air_201 gain [IR gain_air_201_gain]";
  parameter Real gain_norm_201_gain(unit = "1") = 658.327847 "gain_norm_201 gain [IR gain_norm_201_gain]";
  parameter Real gain_peo_201_gain(unit = "kg/s") = 8.18e-8 "gain_peo_201 gain [IR gain_peo_201_gain]";
  parameter Real sch_occ_201_times[1](unit = "s") = 0.0 "sch_occ_201 times [IR sch_occ_201_times]";
  parameter Real sch_occ_201_times[2](unit = "s") = 25200.0 "sch_occ_201 times [IR sch_occ_201_times]";
  parameter Real sch_occ_201_times[3](unit = "s") = 28800.0 "sch_occ_201 times [IR sch_occ_201_times]";
  parameter Real sch_occ_201_times[4](unit = "s") = 36000.0 "sch_occ_201 times [IR sch_occ_201_times]";
  parameter Real sch_occ_201_times[5](unit = "s") = 43200.0 "sch_occ_201 times [IR sch_occ_201_times]";
  parameter Real sch_occ_201_times[6](unit = "s") = 46800.0 "sch_occ_201 times [IR sch_occ_201_times]";
  parameter Real sch_occ_201_times[7](unit = "s") = 54000.0 "sch_occ_201 times [IR sch_occ_201_times]";
  parameter Real sch_occ_201_times[8](unit = "s") = 61200.0 "sch_occ_201 times [IR sch_occ_201_times]";
  parameter Real sch_occ_201_times[9](unit = "s") = 64800.0 "sch_occ_201 times [IR sch_occ_201_times]";
  parameter Real sch_occ_201_values[1](unit = "1") = 0.0 "sch_occ_201 values [IR sch_occ_201_values]";
  parameter Real sch_occ_201_values[2](unit = "1") = 2.0 "sch_occ_201 values [IR sch_occ_201_values]";
  parameter Real sch_occ_201_values[3](unit = "1") = 8.0 "sch_occ_201 values [IR sch_occ_201_values]";
  parameter Real sch_occ_201_values[4](unit = "1") = 12.0 "sch_occ_201 values [IR sch_occ_201_values]";
  parameter Real sch_occ_201_values[5](unit = "1") = 4.0 "sch_occ_201 values [IR sch_occ_201_values]";
  parameter Real sch_occ_201_values[6](unit = "1") = 15.0 "sch_occ_201 values [IR sch_occ_201_values]";
  parameter Real sch_occ_201_values[7](unit = "1") = 10.0 "sch_occ_201 values [IR sch_occ_201_values]";
  parameter Real sch_occ_201_values[8](unit = "1") = 3.0 "sch_occ_201 values [IR sch_occ_201_values]";
  parameter Real sch_occ_201_values[9](unit = "1") = 0.0 "sch_occ_201 values [IR sch_occ_201_values]";
  parameter Real set_co2_201_value(unit = "1") = 1.0 "set_co2_201 value [IR set_co2_201_value]";
  parameter Real set_oa_201_value(unit = "kg/kg") = 4.557e-4 "set_oa_201 value [IR set_oa_201_value]";
  parameter Real src_co2_201_concentration(unit = "kg/kg") = 100.0 "src_co2_201 concentration [IR src_co2_201_concentration]";
  parameter Real system_nominal_concentration(unit = "kg/kg") = 0.001519 "system nominal_concentration [IR system_nominal_concentration]";
  parameter Real system_output_interval(unit = "s") = 60.0 "system output_interval, verification only [IR system_output_interval]";
  parameter Real system_stop_time(unit = "s") = 86400.0 "system stop_time, verification only [IR system_stop_time]";
  parameter Real zon_201_density(unit = "kg/m3") = 1.2 "zon_201 density [IR zon_201_density]";
  parameter Real zon_201_initial_concentration(unit = "kg/kg") = 4.557e-4 "zon_201 initial_concentration [IR zon_201_initial_concentration]";
  parameter Real zon_201_volume(unit = "m3") = 100.0 "zon_201 volume [IR zon_201_volume]";
  Real bnd_201.inlet.m_flow(unit = "kg/s") "Mass flow in the direction of the connection";
  Real bnd_201.inlet.C(unit = "kg/kg") "Trace-substance mass fraction of that flow";
  parameter Real ctl_co2_201.k = ctl_co2_201_gain "Gain on measurement minus setpoint";
  parameter Real ctl_co2_201.bias = ctl_co2_201_bias "Output when the measurement equals the setpoint";
  parameter Real ctl_co2_201.yMin = ctl_co2_201_output_min "Lower output limit";
  parameter Real ctl_co2_201.yMax = ctl_co2_201_output_max "Upper output limit";
  Real ctl_co2_201.u_s "Setpoint";
  Real ctl_co2_201.u_m "Measurement";
  Real ctl_co2_201.y "Limited command";
  parameter Real gain_air_201.k(start = 1.0) = gain_air_201_gain "Gain value multiplied with input signal";
  Real gain_air_201.u "Input signal connector";
  Real gain_air_201.y "Output signal connector";
  parameter Real gain_norm_201.k(start = 1.0) = gain_norm_201_gain "Gain value multiplied with input signal";
  Real gain_norm_201.u "Input signal connector";
  Real gain_norm_201.y "Output signal connector";
  parameter Real gain_peo_201.k(start = 1.0) = gain_peo_201_gain "Gain value multiplied with input signal";
  Real gain_peo_201.u "Input signal connector";
  Real gain_peo_201.y "Output signal connector";
  parameter Real sch_occ_201.times[1](unit = "s") = sch_occ_201_times[1] "Times the value changes, ascending";
  parameter Real sch_occ_201.times[2](unit = "s") = sch_occ_201_times[2] "Times the value changes, ascending";
  parameter Real sch_occ_201.times[3](unit = "s") = sch_occ_201_times[3] "Times the value changes, ascending";
  parameter Real sch_occ_201.times[4](unit = "s") = sch_occ_201_times[4] "Times the value changes, ascending";
  parameter Real sch_occ_201.times[5](unit = "s") = sch_occ_201_times[5] "Times the value changes, ascending";
  parameter Real sch_occ_201.times[6](unit = "s") = sch_occ_201_times[6] "Times the value changes, ascending";
  parameter Real sch_occ_201.times[7](unit = "s") = sch_occ_201_times[7] "Times the value changes, ascending";
  parameter Real sch_occ_201.times[8](unit = "s") = sch_occ_201_times[8] "Times the value changes, ascending";
  parameter Real sch_occ_201.times[9](unit = "s") = sch_occ_201_times[9] "Times the value changes, ascending";
  parameter Real sch_occ_201.values[1] = sch_occ_201_values[1] "Value from each time until the next";
  parameter Real sch_occ_201.values[2] = sch_occ_201_values[2] "Value from each time until the next";
  parameter Real sch_occ_201.values[3] = sch_occ_201_values[3] "Value from each time until the next";
  parameter Real sch_occ_201.values[4] = sch_occ_201_values[4] "Value from each time until the next";
  parameter Real sch_occ_201.values[5] = sch_occ_201_values[5] "Value from each time until the next";
  parameter Real sch_occ_201.values[6] = sch_occ_201_values[6] "Value from each time until the next";
  parameter Real sch_occ_201.values[7] = sch_occ_201_values[7] "Value from each time until the next";
  parameter Real sch_occ_201.values[8] = sch_occ_201_values[8] "Value from each time until the next";
  parameter Real sch_occ_201.values[9] = sch_occ_201_values[9] "Value from each time until the next";
  Real sch_occ_201.y "Scheduled value";
  protected final parameter Integer sch_occ_201.table.nout(min = 1) = 1 "Number of outputs";
  protected Real sch_occ_201.table.y[1] "Connector of Real output signals";
  protected final parameter Boolean sch_occ_201.table.tableOnFile = false "= true, if table is defined on file or in function usertab";
  protected parameter Real sch_occ_201.table.table[1,1] = sch_occ_201.times[1] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter Real sch_occ_201.table.table[1,2] = sch_occ_201.values[1] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter Real sch_occ_201.table.table[2,1] = sch_occ_201.times[2] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter Real sch_occ_201.table.table[2,2] = sch_occ_201.values[2] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter Real sch_occ_201.table.table[3,1] = sch_occ_201.times[3] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter Real sch_occ_201.table.table[3,2] = sch_occ_201.values[3] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter Real sch_occ_201.table.table[4,1] = sch_occ_201.times[4] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter Real sch_occ_201.table.table[4,2] = sch_occ_201.values[4] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter Real sch_occ_201.table.table[5,1] = sch_occ_201.times[5] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter Real sch_occ_201.table.table[5,2] = sch_occ_201.values[5] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter Real sch_occ_201.table.table[6,1] = sch_occ_201.times[6] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter Real sch_occ_201.table.table[6,2] = sch_occ_201.values[6] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter Real sch_occ_201.table.table[7,1] = sch_occ_201.times[7] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter Real sch_occ_201.table.table[7,2] = sch_occ_201.values[7] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter Real sch_occ_201.table.table[8,1] = sch_occ_201.times[8] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter Real sch_occ_201.table.table[8,2] = sch_occ_201.values[8] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter Real sch_occ_201.table.table[9,1] = sch_occ_201.times[9] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter Real sch_occ_201.table.table[9,2] = sch_occ_201.values[9] "Table matrix (time = first column; e.g., table=[0, 0; 1, 1; 2, 4])";
  protected parameter String sch_occ_201.table.tableName = "NoName" "Table name on file or in function usertab (see docu)";
  protected parameter String sch_occ_201.table.fileName = "NoName" "File where matrix is stored";
  protected parameter String sch_occ_201.table.delimiter = "," "Column delimiter character for CSV file";
  protected parameter Integer sch_occ_201.table.nHeaderLines = 0 "Number of header lines to ignore for CSV file";
  protected parameter Boolean sch_occ_201.table.verboseRead = true "= true, if info message that file is loading is to be printed";
  protected parameter Integer sch_occ_201.table.columns[1] = 2 "Columns of table to be interpolated";
  protected final parameter enumeration(LinearSegments, ContinuousDerivative, ConstantSegments, MonotoneContinuousDerivative1, MonotoneContinuousDerivative2, ModifiedContinuousDerivative) sch_occ_201.table.smoothness = Modelica.Blocks.Types.Smoothness.ConstantSegments "Smoothness of table interpolation";
  protected final parameter enumeration(HoldLastPoint, LastTwoPoints, Periodic, NoExtrapolation) sch_occ_201.table.extrapolation = Modelica.Blocks.Types.Extrapolation.HoldLastPoint "Extrapolation of data outside the definition range";
  protected final parameter Real sch_occ_201.table.timeScale(quantity = "Time", unit = "s", min = 2.220446049250313e-16) = 1.0 "Time scale of first table column";
  protected parameter Real sch_occ_201.table.offset[1] = 0.0 "Offsets of output signals";
  protected parameter Real sch_occ_201.table.startTime(quantity = "Time", unit = "s") = 0.0 "Output = offset for time < startTime";
  protected parameter Real sch_occ_201.table.shiftTime(quantity = "Time", unit = "s") = sch_occ_201.table.startTime "Shift time of first table column";
  protected parameter enumeration(Always, AtDiscontinuities, NoTimeEvents) sch_occ_201.table.timeEvents = Modelica.Blocks.Types.TimeEvents.Always "Time event handling of table interpolation";
  protected final parameter Boolean sch_occ_201.table.verboseExtrapolation = false "= true, if warning messages are to be printed if time is outside the table definition range";
  protected final parameter Real sch_occ_201.table.t_min(quantity = "Time", unit = "s") = sch_occ_201.table.t_minScaled "Minimum abscissa value defined in table";
  protected final parameter Real sch_occ_201.table.t_max(quantity = "Time", unit = "s") = sch_occ_201.table.t_maxScaled "Maximum abscissa value defined in table";
  protected final parameter Real sch_occ_201.table.t_minScaled = Modelica.Blocks.Tables.Internal.getTimeTableTmin(sch_occ_201.table.tableID) "Minimum (scaled) abscissa value defined in table";
  protected final parameter Real sch_occ_201.table.t_maxScaled = Modelica.Blocks.Tables.Internal.getTimeTableTmax(sch_occ_201.table.tableID) "Maximum (scaled) abscissa value defined in table";
  protected final parameter Real sch_occ_201.table.p_offset[1] = sch_occ_201.table.offset[1] "Offsets of output signals";
  protected parameter Modelica.Blocks.Types.ExternalCombiTimeTable sch_occ_201.table.tableID = Modelica.Blocks.Types.ExternalCombiTimeTable.constructor("NoName", "NoName", sch_occ_201.table.table, sch_occ_201.table.startTime, sch_occ_201.table.columns, Modelica.Blocks.Types.Smoothness.ConstantSegments, Modelica.Blocks.Types.Extrapolation.HoldLastPoint, sch_occ_201.table.shiftTime, Modelica.Blocks.Types.TimeEvents.Always, false, sch_occ_201.table.delimiter, sch_occ_201.table.nHeaderLines) "External table object";
  protected discrete Real sch_occ_201.table.nextTimeEvent(quantity = "Time", unit = "s", start = 0.0, fixed = true) "Next time event instant";
  protected discrete Real sch_occ_201.table.nextTimeEventScaled(start = 0.0, fixed = true) "Next scaled time event instant";
  protected Real sch_occ_201.table.timeScaled "Scaled time";
  protected final parameter Boolean sch_occ_201.table.isCsvExt = false;
  Real sen_co2_201.u "Connector of Real input signal";
  Real sen_co2_201.y "Connector of Real output signal";
  parameter Real set_co2_201.k(start = 1.0) = set_co2_201_value "Constant output value";
  Real set_co2_201.y "Connector of Real output signal";
  parameter Real set_oa_201.k(start = 1.0) = set_oa_201_value "Constant output value";
  Real set_oa_201.y "Connector of Real output signal";
  parameter Real src_co2_201.C(unit = "kg/kg") = src_co2_201_concentration "Trace-substance mass fraction of the carrier";
  Real src_co2_201.m_flow_in(unit = "kg/s") "Carrier mass flow leaving the source";
  Real src_co2_201.outlet.m_flow(unit = "kg/s") "Mass flow in the direction of the connection";
  Real src_co2_201.outlet.C(unit = "kg/kg") "Trace-substance mass fraction of that flow";
  Real src_oa_201.m_flow_in(unit = "kg/s") "Mass flow at the source port, positive into the source";
  Real src_oa_201.C_in(unit = "kg/kg") "Trace-substance mass fraction supplied";
  Real src_oa_201.outlet.m_flow(unit = "kg/s") "Mass flow in the direction of the connection";
  Real src_oa_201.outlet.C(unit = "kg/kg") "Trace-substance mass fraction of that flow";
  parameter Real zon_201.V(unit = "m3") = zon_201_volume "Air volume";
  parameter Real zon_201.rho(unit = "kg/m3") = zon_201_density "Air density, constant";
  parameter Real zon_201.C_start(unit = "kg/kg") = zon_201_initial_concentration "Initial trace-substance mass fraction";
  Real zon_201.supply.m_flow(unit = "kg/s") "Mass flow in the direction of the connection";
  Real zon_201.supply.C(unit = "kg/kg") "Trace-substance mass fraction of that flow";
  Real zon_201.source.m_flow(unit = "kg/s") "Mass flow in the direction of the connection";
  Real zon_201.source.C(unit = "kg/kg") "Trace-substance mass fraction of that flow";
  Real zon_201.exhaust.m_flow(unit = "kg/s") "Mass flow in the direction of the connection";
  Real zon_201.exhaust.C(unit = "kg/kg") "Trace-substance mass fraction of that flow";
  Real zon_201.concentration(unit = "kg/kg") "Room trace mass fraction";
  Real zon_201.C(unit = "kg/kg", start = zon_201.C_start, fixed = true) "Room trace mass fraction";
equation
  src_oa_201.outlet.C = zon_201.supply.C "air [IR if_air_01]";
  src_oa_201.outlet.m_flow = zon_201.supply.m_flow "air [IR if_air_01]";
  zon_201.exhaust.C = bnd_201.inlet.C "air [IR if_air_03]";
  zon_201.exhaust.m_flow = bnd_201.inlet.m_flow "air [IR if_air_03]";
  sch_occ_201.y = gain_peo_201.u "people count [IR if_sig_01]";
  gain_peo_201.y = src_co2_201.m_flow_in "carrier mass flow [IR if_sig_02]";
  set_oa_201.y = src_oa_201.C_in "outdoor mass fraction [IR if_sig_03]";
  zon_201.concentration = sen_co2_201.u "room mass fraction [IR if_sig_04]";
  sen_co2_201.y = gain_norm_201.u "measured mass fraction [IR if_sig_05]";
  gain_norm_201.y = ctl_co2_201.u_m "normalised CO2 [IR if_sig_06]";
  set_co2_201.y = ctl_co2_201.u_s "normalised setpoint [IR if_sig_07]";
  ctl_co2_201.y = gain_air_201.u "ACH command [IR if_sig_08]";
  gain_air_201.y = src_oa_201.m_flow_in "source mass-flow command [IR if_sig_09]";
  src_co2_201.outlet.C = zon_201.source.C "trace substance [IR if_trc_01]";
  src_co2_201.outlet.m_flow = zon_201.source.m_flow "trace substance [IR if_trc_01]";
  ctl_co2_201.y = min(ctl_co2_201.yMax, max(ctl_co2_201.yMin, ctl_co2_201.bias + ctl_co2_201.k * (ctl_co2_201.u_m - ctl_co2_201.u_s)));
  gain_air_201.y = gain_air_201.k * gain_air_201.u;
  gain_norm_201.y = gain_norm_201.k * gain_norm_201.u;
  gain_peo_201.y = gain_peo_201.k * gain_peo_201.u;
  sch_occ_201.table.timeScaled = time;
  when {time >= pre(sch_occ_201.table.nextTimeEvent), initial()} then
    sch_occ_201.table.nextTimeEventScaled = Modelica.Blocks.Tables.Internal.getNextTimeEvent(sch_occ_201.table.tableID, sch_occ_201.table.timeScaled);
    sch_occ_201.table.nextTimeEvent = if sch_occ_201.table.nextTimeEventScaled < 1e60 then sch_occ_201.table.nextTimeEventScaled else 1e60;
  end when;
  sch_occ_201.table.y[1] = sch_occ_201.table.p_offset[1] + Modelica.Blocks.Tables.Internal.getTimeTableValueNoDer(sch_occ_201.table.tableID, 1, sch_occ_201.table.timeScaled, sch_occ_201.table.nextTimeEventScaled, pre(sch_occ_201.table.nextTimeEventScaled));
  sch_occ_201.y = sch_occ_201.table.y[1];
  sen_co2_201.y = sen_co2_201.u;
  set_co2_201.y = set_co2_201.k;
  set_oa_201.y = set_oa_201.k;
  src_co2_201.outlet.m_flow = src_co2_201.m_flow_in;
  src_co2_201.outlet.C = src_co2_201.C;
  src_oa_201.outlet.m_flow = -src_oa_201.m_flow_in;
  src_oa_201.outlet.C = src_oa_201.C_in;
  zon_201.rho * zon_201.V * der(zon_201.C) = zon_201.supply.m_flow * (zon_201.supply.C - zon_201.C) + zon_201.source.m_flow * (zon_201.source.C - zon_201.C);
  zon_201.exhaust.m_flow = zon_201.supply.m_flow + zon_201.source.m_flow;
  zon_201.exhaust.C = zon_201.C;
  zon_201.concentration = zon_201.C;
end room_co2_ventilation.System;
