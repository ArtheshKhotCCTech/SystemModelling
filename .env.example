# .env.example: copy to .env in the project root and fill in.
# Never commit the real file; it holds the API key. .env is in .gitignore.
# specalive/config.py reads .env from the working directory. A real environment variable of the
# same name overrides the .env value. Blank or missing values fall back to the defaults shown.
# Write values unquoted or in single quotes; double quotes turn backslashes into escapes.

# --- Required ---
OPENAI_API_KEY=

# --- Toolchain ---
# Full path to omc.exe, or leave as "omc" if OpenModelica's bin folder is on PATH.
SPECALIVE_OMC=C:\Program Files\OpenModelica1.27.1-64bit\bin\omc.exe
SPECALIVE_MSL_VERSION=4.0.0
# The SysML v2 Pilot Implementation needs Java 21; point this at a Java 21 java.exe.
SPECALIVE_JAVA=tools\jdk-21.0.12.1+1-jre\bin\java.exe
SPECALIVE_SYSML_VALIDATOR=tools/sysml-pilot/sysml

# --- LLM ---
SPECALIVE_MODEL=gpt-4o
SPECALIVE_CACHE_DIR=.specalive_cache
# USD per million tokens, used for the per-call cost estimate.
SPECALIVE_PRICE_IN=2.50
SPECALIVE_PRICE_OUT=10.00
# Send diagrams and other images to the vision model during ingest (1/0). Off by default:
# images are then recorded as unread, with the reason.
SPECALIVE_VISION=0

# --- Timeouts (seconds) and limits ---
SPECALIVE_OMC_TIMEOUT=600
SPECALIVE_VALIDATOR_TIMEOUT=180
SPECALIVE_LLM_TIMEOUT=120
SPECALIVE_REPAIR_ATTEMPTS=3

# PYTHONUTF8=1 does NOT belong here: Python reads it at interpreter start, before .env is
# loaded. Set it in your shell or user environment instead (docs/devenv.md step 6).
