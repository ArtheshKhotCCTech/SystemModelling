// Simulates the model in this folder over its experiment (start/stop/interval in model.mo)
// and writes room_co2_ventilation.System_res.csv. Run from this folder:  omc simulate.mos
loadModel(Modelica, {"4.0.0"}); getErrorString();
loadFile("model.mo"); getErrorString();
simulate(room_co2_ventilation.System, outputFormat="csv"); getErrorString();
